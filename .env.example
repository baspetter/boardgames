# PostgreSQL
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boardgames

# Only used outside Docker (e.g. running `npm run dev` locally against the db container)
DATABASE_URL=postgresql://boardgames:change-me@localhost:5432/boardgames

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Public URL the app is reachable on (used for auth callbacks/cookies)
AUTH_URL=http://localhost:3000

# Port the app is published on (host side)
APP_PORT=3000

# Optional: fix the first invite code instead of a random one (see docker logs otherwise)
SEED_INVITE_CODE=
SEED_INVITE_MAX_USES=20

# Required for BGG search/add to work. BGG requires a registered, approved
# application with an Authorization: Bearer token — register at
# https://boardgamegeek.com/applications (choose "Non-commercial"), wait for
# approval (can take a week or more), then create a token under "Tokens" for
# your application and paste it here.
BGG_API_TOKEN=
